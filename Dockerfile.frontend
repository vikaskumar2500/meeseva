# Multi-stage Dockerfile for Meeseva Frontend in Monorepo
FROM node:22-alpine AS builder

WORKDIR /app
RUN npm install -g pnpm@10.32.1

# Copy monorepo manifests
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY packages/ ./packages/
COPY Meeseva-lite-frontend/package.json ./Meeseva-lite-frontend/
COPY Meeseva-lite-frontend/tsconfig*.json ./Meeseva-lite-frontend/
COPY Meeseva-lite-frontend/vite.config.ts ./Meeseva-lite-frontend/
COPY Meeseva-lite-frontend/tailwind.config.js ./Meeseva-lite-frontend/
COPY Meeseva-lite-frontend/postcss.config.js ./Meeseva-lite-frontend/

# Install workspace dependencies
RUN pnpm install --frozen-lockfile

# Copy frontend source and HTML
COPY Meeseva-lite-frontend/index.html ./Meeseva-lite-frontend/
COPY Meeseva-lite-frontend/src ./Meeseva-lite-frontend/src

# Build shared package and frontend
RUN pnpm --filter @meeseva/shared build && pnpm --filter @meeseva/frontend build

# Nginx Production Stage
FROM nginx:alpine AS runner

COPY --from=builder /app/Meeseva-lite-frontend/dist /usr/share/nginx/html
COPY Meeseva-lite-frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
